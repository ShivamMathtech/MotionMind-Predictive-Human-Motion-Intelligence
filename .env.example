# Copy to .env to override these values. start.py reads this file.
PORT=8000
# SQLite is the default; leave unset to use data/motionmind.db.
# DATABASE_URL=sqlite:////absolute/path/to/motionmind.db
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080
SMOOTHING_FACTOR=0.65
MIN_CONFIDENCE=0.55
MIN_REP_SECONDS=0.6
FEEDBACK_COOLDOWN=2
